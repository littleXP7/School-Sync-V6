{
  "name": "school-sync",
  "version": "6.0.0",
  "description": "WhatsApp school PDF -> TickTick books list",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "pdf-parse": "1.1.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "git+https://github.com/pedroslopez/whatsapp-web.js.git"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.schoolsync.app",
    "productName": "School Sync",
    "files": [
      "**/*",
      "!assets/icon.svg"
    ],
    "asarUnpack": [
      "node_modules/puppeteer*/**",
      "node_modules/@puppeteer/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "icon": "assets/icon.png"
  }
}